# GCP
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCS_BUCKET=your-project-id-oss-pulse-lake
BQ_DATASET_RAW=oss_pulse_raw
BQ_DATASET_STAGING=oss_pulse_staging
BQ_DATASET_MARTS=oss_pulse_marts
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Terraform remote state (created once by `make tf-bootstrap`)
TF_STATE_BUCKET=your-project-id-tfstate

# Airflow
AIRFLOW_UID=50000
