# GCP
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCS_BUCKET=your-project-id-oss-pulse-lake
BQ_DATASET_RAW=oss_pulse_raw
BQ_DATASET_STAGING=oss_pulse_staging
BQ_DATASET_MARTS=oss_pulse_marts
BQ_DATASET_AUDIT=oss_pulse_audit

# dbt: personal development dataset (created by dbt on first run)
DBT_DEV_DATASET=dbt_yourname

# Terraform remote state (created once by `make tf-bootstrap`)
TF_STATE_BUCKET=your-project-id-tfstate

# Airflow (make up). Tasks authenticate with your ADC login, mounted read-only:
#   gcloud auth application-default login
# Point GCP_ADC_FILE elsewhere to use another credentials file (keep it outside the repo).
# macOS/Windows: keep 50000. Linux: set to the output of `id -u`, so log files stay writable.
AIRFLOW_UID=50000
# GCP_ADC_FILE=/path/outside/repo/adc.json
# Encrypts connections/variables in Airflow's DB. Generate one:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FERNET_KEY=
# Days the DAG schedules (YYYY-MM-DD). Once unpaused it creates one run per day from START
# (default 2026-10-01) up to END (unset = keep running daily). Same day for both = a one-day demo.
# OSS_PULSE_START_DATE=2026-10-31
# OSS_PULSE_END_DATE=2026-10-31
# Optional: Slack incoming webhook for failure alerts (unset = alerts are only logged).
# AIRFLOW_VAR_SLACK_WEBHOOK_SECRET=https://hooks.slack.com/services/...
